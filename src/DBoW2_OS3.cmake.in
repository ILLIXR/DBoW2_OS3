
@PACKAGE_INIT@

include(FetchContent)
FetchContent_GetProperties(DBoW2_OS3)

if(TARGET DBoW2_OS3)
    if(NOT TARGET DBoW2::DBoW2)
        add_library(DBoW2::DBoW2 INTERFACE IMPORTED GLOBAL)
        set_target_properties(DBoW2::DBoW2 PROPERTIES
            INTERFACE_LINK_LIBRARIES "$<BUILD_INTERFACE:DBoW2_OS3>"
            INTERFACE_INCLUDE_DIRECTORIES "@CMAKE_CURRENT_LIST_DIR@/include"
        )
    endif()

    set(DBoW2_OS3_FOUND TRUE)
    set(DBoW2_OS3_LIBRARIES DBoW2::DBoW2 CACHE STRING "" FORCE)

    get_target_property(_db_inc DBoW2_OS3 INTERFACE_INCLUDE_DIRECTORIES)
    set(DBoW2_OS3_INCLUDE_DIRS "${_db_inc}" CACHE PATH "" FORCE)
    message("DBOW ${DBoW2_OS3_INCLUDE_DIRS}")
    return()
endif()

FIND_LIBRARY(DBoW2_OS3_LIBRARY DBoW2_OS3
    PATHS "@CMAKE_INSTALL_PREFIX@/lib"
)
FIND_PATH(DBoW2_OS3_INCLUDE_DIR DBoW2.h
    PATHS "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME@"
)
LIST(APPEND DBoW2_OS3_INCLUDE_DIR ${DBoW2_OS3_INCLUDE_DIR}/../)
set(DBoW2_OS3_LIBRARIES ${DBoW2_OS3_LIBRARY} CACHE STRING "" FORCE)
set(DBoW2_OS3_LIBS ${DBoW2_OS3_LIBRARY} CACHE STRING "" FORCE)
set(DBoW2_OS3_INCLUDE_DIRS ${DBoW2_OS3_INCLUDE_DIR} CACHE PATH "" FORCE)
